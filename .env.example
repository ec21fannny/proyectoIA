# Copia este archivo como .env o define las variables en tu terminal.
# Sin ANTHROPIC_API_KEY la aplicación funciona con el motor de reglas.
ANTHROPIC_API_KEY=
# Modelo de Claude (opcional). Por defecto: claude-opus-5-5
CLARICOPILOT_MODEL=
# Clave para firmar las sesiones. Cámbiala fuera de desarrollo.
SECRET_KEY=cambia-esta-clave
